# garmin-surreal — copy to .env (git-ignored) and fill in. Never commit .env.

# ── SurrealDB (same variable names as owui-surrealdb-adapter) ──────────────
SURREALDB_URI=ws://surrealdb:8000/rpc
SURREALDB_NS=health
SURREALDB_DB=garmin
# Dedicated database-level user (DEFINE USER ... ON DATABASE ... ROLES EDITOR) — see README.
SURREALDB_USER=garmin_writer
SURREALDB_PASS=change-me
# Only used by compose-example.yml's bundled surrealdb service (root login of that server).
SURREALDB_ROOT_USER=root
SURREALDB_ROOT_PASS=change-me-too

# ── Garmin Connect ─────────────────────────────────────────────────────────
# Optional: leave empty and log in interactively once; tokens are then reused.
GARMINCONNECT_EMAIL=
GARMINCONNECT_BASE64_PASSWORD=
GARMINCONNECT_IS_CN=False

# ── Fetch behaviour (upstream variables) ───────────────────────────────────
USER_TIMEZONE=Europe/Oslo
UPDATE_INTERVAL_SECONDS=300
RATE_LIMIT_CALLS_SECONDS=5
# Everything the fetcher can pull — types your devices do not record just come back empty.
# Add solar_intensity only for a solar watch (on others it skips the rest of each day).
# raw = also keep every raw Garmin response (raw_* tables); extras = also call the endpoints
# upstream never uses (SpO2, floors, Body Battery events, activity details/weather, profile, ...).
FETCH_SELECTION=daily_avg,sleep,steps,heartrate,stress,breathing,hrv,fitness_age,vo2,activity,race_prediction,body_composition,lifestyle,lactate_threshold,training_status,training_readiness,hill_score,endurance_score,blood_pressure,hydration,cycling_dynamics,raw,extras
# Parse FIT files for indoor activities too (per-second HR etc.), and keep the raw FIT files.
ALWAYS_PROCESS_FIT_FILES=True
KEEP_FIT_FILES=True
# Backfill a date range, then exit (YYYY-MM-DD). Keep these commented out in the .env that
# `docker compose up -d` uses — pass them with `docker compose run --rm -e ...` instead
# (see compose-example.yml). An empty MANUAL_END_DATE= would also override the "today" default.
# MANUAL_START_DATE=2026-01-01
# MANUAL_END_DATE=2026-10-23
# Ask Garmin to restore detailed data it has moved to storage (days older than ~6 months)
# before fetching them; Garmin limits this per day, the fetcher then pauses 24 h and goes on.
# REQUEST_INTRADAY_DATA_REFRESH=True
LOG_LEVEL=INFO
